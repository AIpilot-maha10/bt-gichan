# =========================================================
# bt-gichan .gitignore
#  - 추적 대상: AIP_DCS BT 소스, Rule XML, 모니터링 도구, PropertySheets
#  - 제외 대상: 빌드 산출물, 제공받은 RL 프레임워크/대용량 자산, 강의자료
# =========================================================

# ---- 워크스페이스 내 무관/대용량 최상위 폴더 ----
/1일차 강의 자료/
/2일차 강의 자료/
/developbt-jegalmin/
/update/
/.claude/

# ---- 제공 라이브러리 / 대용량 ----
/AIP_LIB/Windows/
/AIP_LIB/bin/
/AIP_LIB/Rule.xml

# ---- DogFightEnv: 제공받은 RL 프레임워크/자산(우리 산출물 아님) ----
/AIP_LIB/DogFightEnv/Release/RLLibLstm/
/AIP_LIB/DogFightEnv/Release/artifacts/
/AIP_LIB/DogFightEnv/Release/aircraft/
/AIP_LIB/DogFightEnv/Release/assets/
/AIP_LIB/DogFightEnv/Release/engine/
/AIP_LIB/DogFightEnv/Release/logs/
/AIP_LIB/DogFightEnv/Release/engagement_logs/

# ---- ★ 우리 산출물이므로 추적한다 (2026-08-02 해제) ----
#  student/     : RL 보상·관측·커리큘럼·제출설정 — CLAUDE.md "학생이 주로 수정할 파일"
#  experiments/ : 실험 YAML (C 스윕·D 학습의 설정 원본)
#  scripts/     : 실험 실행기 — 학습 재현에 필요
#  tools/       : B 스파링 하네스 / C 파라미터 스윕 (신규)
#  이 4개가 무시되면 A/C/D 작업물이 커밋되지 않는다.

# =========================
# Visual Studio / 빌드 산출물
#  (주의: 'Release/' 블랭킷은 DogFightEnv/Release 와 충돌하므로 경로 지정)
# =========================
/AIP_LIB/AIP_DCS/Debug/
/AIP_LIB/AIP_DCS/Release/
